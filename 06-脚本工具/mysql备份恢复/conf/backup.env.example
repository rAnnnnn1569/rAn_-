#!/bin/bash
# ============================================================
# MySQL 备份/恢复 —— 统一配置（生产环境）
# 权限要求: chmod 600 backup.env   chown root:root backup.env
# 说明: 本文件只放路径与策略; 数据库账号密码放同目录 client.cnf
# ============================================================

# ---------- 备份根目录（沿用现网 /opt/databk 结构） ----------
BACKUP_ROOT="/opt/databk"
FULL_DIR="$BACKUP_ROOT/date/mysql"      # 日备（全量）
WEEK_DIR="$BACKUP_ROOT/week/mysql"      # 周备（全量，保留更久）
BINLOG_DIR="$BACKUP_ROOT/binlog"        # 增量（binlog 归档）
LOG_DIR="$BACKUP_ROOT/logs"

# ---------- 备份对象 ----------
# 多个库用空格分隔: DB_NAMES="clbs otherdb"
DB_NAMES="clbs"
# 需要排除的大表（媒体/日志类，体积大且可重新生成）: 库名.表名
IGNORE_TABLES="clbs.zw_m_media clbs.zw_c_log"

# ---------- 保留策略 ----------
KEEP_DAYS_FULL=7           # 日备保留天数
KEEP_DAYS_WEEK=21          # 周备保留天数
KEEP_DAYS_BINLOG=7         # binlog 归档保留天数

# ---------- 安全护栏 ----------
MIN_FREE_MB=2048           # 备份目录剩余空间低于此值(MB)则中止
LOCK_FILE="/var/run/mysql_backup.lock"
NICE_LEVEL=10              # 备份进程降优先级，避免影响业务

# ---------- 二进制路径（按实际环境调整；生产通常为 /usr/bin） ----------
MYSQLDUMP_BIN="/usr/bin/mysqldump"
MYSQL_BIN="/usr/bin/mysql"
MYSQLBINLOG_BIN="/usr/bin/mysqlbinlog"
SHA256_BIN="/usr/bin/sha256sum"
GZIP_BIN="/usr/bin/gzip"
COMPRESS_LEVEL=6

# ---------- 备份时 mysqldump 附加参数 ----------
# --single-transaction : InnoDB 一致性快照，不锁表
# --master-data=2      : 记录 binlog 位点（注释形式），供增量恢复定位
# --set-gtid-purged=OFF: 未启用 GTID 时避免导出 GTID 语句报错
DUMP_EXTRA_OPTS="--single-transaction --quick --routines --events --triggers --master-data=2 --set-gtid-purged=OFF"
